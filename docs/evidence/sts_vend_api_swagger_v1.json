    "/api/Power/MeterRegister": {
      "post": {
        "tags": [
          "Power"
        ],
        "summary": "Register the meter",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "CustomerName",
                  "MeterCode",
                  "MeterType",
                  "Password",
                  "UserId",
                  "UseTypeId"
                ],
                "type": "object",
                "properties": {
                  "UserId": {
                    "type": "string",
                    "description": "The user id"
                  },
                  "Password": {
                    "type": "string",
                    "description": "The password"
                  },
                  "UseTypeId": {
                    "type": "string",
                    "description": "The use type id"
                  },
                  "MeterCode": {
                    "pattern": "^(\\d{1,13},){0,19}\\d{1,13}$",
                    "type": "string",
                    "description": "The meter codes(Supports registering up to 20 meter codes simultaneously. If there are multiple, separate them with commas in English)",
                    "example": "123 or 123,456,789..."
                  },
                  "MeterType": {
                    "pattern": "^[12]$",
                    "type": "integer",
                    "description": "The meter type\r\n1-electric 2-water",
                    "format": "int32",
                    "example": 1
                  },
                  "CustomerName": {
                    "maxLength": 20,
                    "minLength": 0,
                    "type": "string",
                    "description": "The customer name"
                  },
                  "Address": {
                    "maxLength": 50,
                    "minLength": 0,
                    "type": "string",
                    "description": "The address"
                  },
                  "PhoneNumber": {
                    "maxLength": 20,
                    "minLength": 0,
                    "type": "string",
                    "description": "The phone number"
                  },
                  "Fax": {
                    "maxLength": 20,
                    "minLength": 0,
                    "type": "string",
                    "description": "The fax"
                  },
                  "SgcId": {
                    "maxLength": 6,
                    "minLength": 6,
                    "type": "string",
                    "description": "sgc id"
                  },
                  "BillingMode": {
                    "type": "integer",
                    "description": "The billing mode(0-Quantity | 1-Amount)",
                    "format": "int32"
                  }
                }
              },
              "encoding": {
                "UserId": {
                  "style": "form"
                },
                "Password": {
                  "style": "form"
                },
                "UseTypeId": {
                  "style": "form"
                },
                "MeterCode": {
                  "style": "form"
                },
                "MeterType": {
                  "style": "form"
                },
                "CustomerName": {
                  "style": "form"
                },
                "Address": {
                  "style": "form"
                },
                "PhoneNumber": {
                  "style": "form"
                },
                "Fax": {
                  "style": "form"
                },
                "SgcId": {
                  "style": "form"
                },
                "BillingMode": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },

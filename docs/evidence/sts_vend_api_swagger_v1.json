    "/api/WaterVend/PageVend": {
      "post": {
        "tags": [
          "WaterVend"
        ],
        "summary": "Page by page query of water vend records",
        "parameters": [
          {
            "name": "PageNumber",
            "in": "query",
            "description": "The page number (start by 1)",
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "The page size (number of records per page)",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "The water vend query dto",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WaterVendDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/WaterVendDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/WaterVendDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RichResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RichResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RichResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RichResult": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WaterVendDTO": {
        "required": [
          "endDate",
          "meterCode",
          "password",
          "startDate",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "maxLength": 10,
            "minLength": 1,
            "type": "string",
            "description": "The user id"
          },
          "password": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string",
            "description": "The password"
          },
          "meterCode": {
            "maxLength": 13,
            "minLength": 1,
            "type": "string",
            "description": "The meter code"
          },
          "startDate": {

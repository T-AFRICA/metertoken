{
  "name": "@tronic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \".data/**\" --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "test": "vitest run",
    "schema:supabase": "tsx scripts/supabase-schema.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cookie": "^11.0.2",
    "@node-rs/argon2": "^2.0.2",
    "@tronic/core": "*",
    "decimal.js": "^10.4.3",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}

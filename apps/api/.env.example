# Copy to apps/api/.env and fill in. Never commit .env.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Production: a real PostgreSQL server. Leave unset in development to use embedded PGlite.
# DATABASE_URL=postgres://tronic:CHANGE_ME@db-host:5432/tronic_sts
# Supabase: the "Session pooler" connection string (Connect button), and the project's CA certificate
# (Database settings → SSL configuration) so TLS is verified. Newlines in the PEM may be written as \n.
# The empty schema is created on first start, or by pasting supabase/schema.sql into the SQL Editor.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
PGLITE_DIR=.data/pglite

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored tokens unreadable; store it in your secrets manager.
TOKEN_ENC_KEY=

# true behind HTTPS (production). Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
SESSION_TTL_HOURS=12

CURRENCY=TZS
DEFAULT_TARIFF_CODE=DEFAULT
QUOTE_TTL_SECONDS=300
METER_COOLDOWN_SECONDS=60
DUPLICATE_WINDOW_SECONDS=300
MAX_VEND_AMOUNT=1000000
MAX_VEND_UNITS=5000

# First admin, created only when the users table is empty. Remove the password after first start.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Development only: seeds a SAMPLE tariff so the vend screen works. Never in production.
SEED_SAMPLE_TARIFF=true

# ---- STS adapter ---------------------------------------------------------
# mock = default, safe. live = vendor "STS Vend System API"; needs everything below
# AND approval by two admins in the portal (Settings page).
STS_MODE=mock
STS_LIVE_ENABLED=false

# Must be https://, or an http:// host listed in STS_VENDOR_ALLOW_INSECURE_HOSTS (private VPN route only).
# STS_VENDOR_BASE_URL=https://vendor-api.example
# STS_VENDOR_ALLOW_INSECURE_HOSTS=
# Vend-only API account issued by the vendor. Keep in a secrets manager in production.
# STS_VENDOR_USER_ID=
# STS_VENDOR_PASSWORD=
# STS_VENDOR_TIMEOUT_MS=30000
# From the vendor's documentation: RichResult.code values meaning success, and codes that
# definitely mean "no token issued". Unlisted codes go to manual review.
# STS_VENDOR_SUCCESS_CODES=
# STS_VENDOR_REJECT_CODES=
